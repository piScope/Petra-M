--- a/CMakeLists.txt
+++ b/CMakeLists.txt
@@ -30,6 +30,11 @@
 #-- BLAS
 option(TPL_ENABLE_INTERNAL_BLASLIB  "Build the CBLAS library" ${enable_blaslib_DEFAULT})
 option(TPL_BLAS_LIBRARIES "List of absolute paths to blas libraries [].")
+#-- Standalone METIS (Petra-M: no ParMETIS dependency)
+option(TPL_ENABLE_METISLIB "Enable the standalone METIS library" OFF)
+set(TPL_METIS_LIBRARIES "" CACHE STRING "Standalone METIS link libraries")
+set(TPL_METIS_INCLUDE_DIRS "" CACHE STRING "Standalone METIS include directories")
+
 #-- ParMETIS
 option(TPL_ENABLE_PARMETISLIB   "Enable the ParMETIS library" ON)
 option(TPL_PARMETIS_LIBRARIES "List of absolute paths to ParMETIS link libraries [].")
@@ -462,6 +467,16 @@
     message("-- Will not link with MAGMA.")
 endif()
 
+#--------------------- Standalone METIS ---------------------
+if(TPL_ENABLE_METISLIB)
+  if(NOT TPL_METIS_LIBRARIES OR NOT TPL_METIS_INCLUDE_DIRS)
+    message(FATAL_ERROR "Standalone METIS requires TPL_METIS_LIBRARIES and TPL_METIS_INCLUDE_DIRS.")
+  endif()
+  set(METIS_LIB ${TPL_METIS_LIBRARIES})
+  include_directories(${TPL_METIS_INCLUDE_DIRS})
+  set(HAVE_METIS TRUE)
+endif()
+
 #--------------------- ParMETIS ---------------------
 if (TPL_ENABLE_PARMETISLIB)   ## want to use parmetis
   if (NOT TPL_PARMETIS_LIBRARIES)
